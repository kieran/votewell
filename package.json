    "classnames": "^2.2.6",
    "coffeescript": "^2.5.1",
    "core-js": "^3.40.0",
    "dotenv": "^8.2.0",
    "i18next": "^17.3.1",
    "koa": "^2.13.0",
    "koa-router": "^7.4.0",
    "mongodb": "^6.21.0",
    "nodemon": "^1.19.4",
    "npm-run-all": "^4.1.5",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-i18next": "^10.13.2",
